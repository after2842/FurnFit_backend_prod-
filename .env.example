# App
NODE_ENV=production
PORT=3001
SESSION_SECRET=your-strong-random-secret-here

# Frontend URL for CORS (your Vercel deployment URL)
FRONTEND_URL=https://your-app.vercel.app

# Redis (use Fly.io Upstash Redis or external provider)
REDIS_URL=redis://default:password@your-redis-host:6379

# Database (Supabase)
SUPABASE_DIRECT_URL=postgresql://postgres.xxx:password@aws-0-us-west-2.pooler.supabase.com:5432/postgres
SUPABASE_PROJ_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE=your-service-role-key
SUPABASE_API=your-supabase-api-key
SUPABASE_DB_PW=your-db-password

# OpenAI
OPENAI_APIKEY=sk-...

# Claude / Bedrock
CLAUDE_API=sk-ant-...
NOVA_API=your-nova-api-key
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# S3
S3_BUCKET_NAME=furnfitdemo

# OpenSearch
OPENSEARCH_URL=https://your-opensearch-host:9200
OPENSEARCH_PASSWORD=your-opensearch-password

# External services
APIFY_TOKEN=your-apify-token
HF_TOKEN=your-huggingface-token
RESEND_API_KEY=your-resend-api-key
RUNPOD_URL_CR_AND_EMBED=https://your-runpod-endpoint/crop-and-embed
RUNPOD_API_KEY=your-runpod-api-key
RUNPOD_URL_EMBED=https://your-runpod-endpoint/embed
